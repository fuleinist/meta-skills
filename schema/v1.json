{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://meta-skills.dev/schema/v1.json",
  "title": "Meta-Skills Index",
  "description": "A lightweight JSON index for agent skill discovery. Agents read this file (~150 tokens) to know what skills exist and when to use them, without loading every SKILL.md upfront.",
  "type": "object",
  "required": ["version", "generated", "source", "skills"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema URI for validation"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Schema version (semver major.minor)"
    },
    "generated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when this index was generated"
    },
    "source": {
      "type": "string",
      "enum": ["global", "project"],
      "description": "global = agent-wide skills, project = per-codebase skills"
    },
    "skills": {
      "type": "array",
      "description": "Active skills available for use",
      "items": {
        "$ref": "#/definitions/SkillEntry"
      }
    },
    "stale": {
      "type": "array",
      "description": "Archived skills (unused >60 days, kept for reference)",
      "items": {
        "$ref": "#/definitions/SkillEntry"
      }
    },
    "bundles": {
      "type": "array",
      "description": "User-defined skill bundles (v1.8+)",
      "items": {
        "$ref": "#/definitions/BundleEntry"
      }
    },
    "suggested_bundles": {
      "type": "array",
      "description": "Auto-detected co-occurrence bundles (v0.4+)",
      "items": {
        "$ref": "#/definitions/SuggestedBundle"
      }
    },
    "rollback": {
      "type": "object",
      "description": "Rollback ledger metadata (v0.1.2)",
      "properties": {
        "history_count": { "type": "integer", "minimum": 0 },
        "last_snapshot": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "project_context": {
      "type": "object",
      "description": "Project-specific context (only in project-level meta-skills)",
      "properties": {
        "name": { "type": "string" },
        "tech_stack": {
          "type": "array",
          "items": { "type": "string" }
        },
        "key_files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "patterns": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "SkillEntry": {
      "type": "object",
      "required": ["id", "when", "why", "path", "priority"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
          "maxLength": 64,
          "description": "Skill name (matches SKILL.md frontmatter name)"
        },
        "when": {
          "type": "string",
          "maxLength": 200,
          "description": "Trigger conditions — when should the agent activate this skill"
        },
        "why": {
          "type": "string",
          "maxLength": 200,
          "description": "Rationale — what value this skill provides"
        },
        "path": {
          "type": "string",
          "description": "Path to the SKILL.md file (relative or absolute)"
        },
        "priority": {
          "type": "string",
          "enum": ["high", "medium", "low", "archived"],
          "description": "Priority tier — high always shown, medium/low on demand, archived = stale"
        },
        "usage_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of times this skill has been activated"
        },
        "last_used": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO-8601 timestamp of last activation"
        },
        "archived": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO-8601 timestamp when this skill was archived"
        },
        "version": {
          "type": ["string", "null"],
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version of the SKILL.md (v0.1.1)"
        },
        "engines": {
          "type": ["object", "null"],
          "description": "Engine compatibility constraints (v0.1.1)",
          "properties": {
            "meta-skills": { "type": "string" },
            "node": { "type": "string", "description": "Node.js version constraint (e.g. '>=18.0.0')" }
          },
          "additionalProperties": true
        },
        "deprecated": {
          "type": ["boolean", "null"],
          "description": "Whether this skill is deprecated (v0.1.7)"
        },
        "successor": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "description": "ID of the successor skill (v0.1.7)"
        },
        "requires": {
          "type": ["array", "null"],
          "description": "Skill IDs this skill depends on (v0.1.3)",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          }
        },
        "permissions": {
          "type": ["array", "null"],
          "description": "Authorized access levels for this skill (v0.1.5)",
          "items": {
            "type": "string",
            "enum": ["fs-read", "fs-write", "network", "shell-exec", "env-read", "process-exec"]
          }
        },
        "empirical_tokens": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Empirically measured token count (v0.1.4)"
        },
        "avg_quality": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100,
          "description": "Average quality score from v1.6 (v0.1.x)"
        }
      }
    },
    "BundleEntry": {
      "type": "object",
      "required": ["name", "skills"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "description": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "enum": ["user"] }
      }
    },
    "SuggestedBundle": {
      "type": "object",
      "required": ["skills", "cooccurrenceDays"],
      "properties": {
        "skills": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
        "cooccurrenceDays": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
